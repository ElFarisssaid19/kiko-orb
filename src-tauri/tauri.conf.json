{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiko",
  "version": "0.1.0",
  "identifier": "dev.elfariss.kiko",
  "build": {
    "beforeDevCommand": "npm run dev:app",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kiko",
        "width": 420,
        "height": 120,
        "minWidth": 420,
        "maxWidth": 420,
        "minHeight": 120,
        "maxHeight": 120,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
